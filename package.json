  "overrides": {
    "postcss": "^8.5.28"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
    "eslint-config-next": "15.5.26",
    "postcss": "^8.5.28",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
