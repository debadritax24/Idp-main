# ==============================================================================
# Environment Configuration Template (.env.example)
# Passwordless Authentication Identity Provider (College IDP)
# ==============================================================================
# Copy this file to .env and configure with your specific values:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime Configuration
# ------------------------------------------------------------------------------
# Public URL of the web application. Used to construct verification magic links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment mode: 'development' | 'production' | 'test'
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Transaction pooler connection string (PgBouncer port 6543)
# Recommended for serverless route handlers and high-concurrency environments.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct / Session pooler connection string (port 5432)
# Used as a fallback connection and for schema migrations (DDL).
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional: Supabase project reference and public anon key (for CI keepalive HTTP gateway pings)
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 3. SMTP Email Delivery Provider (Nodemailer)
# ------------------------------------------------------------------------------
# SMTP server hostname (e.g. smtp.gmail.com, smtp.sendgrid.net, smtp.resend.com)
SMTP_HOST=smtp.gmail.com

# SMTP port: 587 (STARTTLS) or 465 (SSL/TLS)
SMTP_PORT=587

# Enforce direct TLS (set to true for port 465, false for 587)
SMTP_SECURE=false

# SMTP authentication credentials
SMTP_USER=your-email@example.com
SMTP_PASSWORD="your-app-specific-password"

# Sender envelope and display name
SMTP_FROM="College IDP Auth <your-email@example.com>"

# ------------------------------------------------------------------------------
# 4. Security & Cryptographic Salts
# ------------------------------------------------------------------------------
# Cryptographically random 32+ byte string used for IP address rate-limit hashing.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAGIC_LINK_SECRET=generate-a-cryptographically-secure-random-32-byte-secret-hex

# ------------------------------------------------------------------------------
# 5. Developer & Demo Experience
# ------------------------------------------------------------------------------
# When enabled in development ('true'), dispatches link events in memory
# and logs magic link URLs directly to the terminal for easy testing.
# Set to 'false' in production.
DEMO_MODE=true
